# ==========================================
# Document Summary Assistant Environment Configuration
# ==========================================

# Port for FastAPI server (default: 8000)
PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# AI Provider API Keys (Optional - built-in extractive NLP fallback works out-of-the-box)
# Google Gemini API key (recommended free tier: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API key (optional alternative)
OPENAI_API_KEY=

# Path to Tesseract OCR executable (required for Image OCR if not in system PATH)
# Examples:
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# macOS: /opt/homebrew/bin/tesseract
TESSERACT_CMD=
